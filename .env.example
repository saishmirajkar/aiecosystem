# ---------------------------------------------------------------------------
# Above Industrial AI — per-customer deployment configuration.
# Copy to .env and replace every placeholder. Never commit .env.
# ---------------------------------------------------------------------------

# production | demo | development. "production" forces Secure cookies (serve over HTTPS)
# and refuses to start with a weak SECRET_KEY. Use "demo" for local HTTP evaluation.
ENVIRONMENT=production
SECRET_KEY=replace-with-a-64-character-random-string-from-a-secret-manager

# Database (docker-compose builds DATABASE_URL from these three values)
POSTGRES_USER=above
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=above
# When running the backend outside Docker instead:
# DATABASE_URL=postgresql+psycopg://above:<password>@localhost:5432/above
# REDIS_URL=redis://localhost:6379/0

# Public origin(s) of the web app (comma separated)
CORS_ORIGINS=https://erp.customer.example
FRONTEND_URL=https://erp.customer.example
HTTP_PORT=8080

# Sessions and request limits
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_MB=10

# AI — leave ANTHROPIC_API_KEY empty to run the Command Center in offline mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_FALLBACKS_ENABLED=true
AI_ENGINE=auto
AI_MAX_ITERATIONS=8
AI_MAX_TOOL_CALLS=12

# Mail: "console" logs password-reset links (SMTP integration is a planned next step)
MAIL_BACKEND=console
